# =====================================================================
# Automated Job Agent — Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.
# DO NOT commit '.env' to git!
# =====================================================================

# Server Settings
PROJECT_NAME="Automated Job Agent"
DATABASE_URL="sqlite:///./job_agent.db"

# LLM Provider API Keys (Optional — system falls back gracefully)
# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# xAI Grok API Key (https://console.x.ai/)
GROK_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# HuggingFace Token (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Local Ollama Server URL (default: http://localhost:11434)
OLLAMA_URL=

# LLM Routing Strategy: "balanced", "cost_optimized", "quality_first", "local_only"
LLM_ROUTING_STRATEGY=balanced

# Observability & Tracing (Dual Setup: LangSmith + Langfuse)
# LangSmith Tracing Keys (https://smith.langchain.com/)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Automated-Job-Agent

# Langfuse Tracing Keys (US Region: https://us.cloud.langfuse.com | EU Region: https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=

# Storage Directories
STORAGE_PATH=./storage
RESUMES_PATH=./storage/resumes
SCREENSHOTS_PATH=./storage/screenshots
BROWSER_PROFILES_PATH=./storage/browser_profiles
